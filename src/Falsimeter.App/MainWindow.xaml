<Window x:Class="Falsimeter.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Falsimeter" Height="780" Width="1260" MinWidth="950" MinHeight="600" Background="#0C1623" Foreground="#E7F0FF" FontFamily="Segoe UI" Icon="Assets/Falsimeter.ico">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E7F0FF"/><Setter Property="Background" Value="#192738"/><Setter Property="BorderBrush" Value="#30475E"/><Setter Property="Padding" Value="18,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#48C7FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#172535"/><Setter Property="Foreground" Value="#DCEBFF"/><Setter Property="Padding" Value="18,18"/><Setter Property="FontSize" Value="16"/><Setter Property="BorderBrush" Value="#263A4E"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#203A54"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Background="#0C1623"><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
  <Border BorderBrush="#26394B" BorderThickness="0,0,0,1" Padding="28,16"><StackPanel Orientation="Horizontal"><Image Width="104" Height="112" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"><Image.Source><CroppedBitmap Source="Assets/Falsimeter-title-lockup.png" SourceRect="50,160,450,500"/></Image.Source></Image><StackPanel VerticalAlignment="Center" Margin="15,0,0,0"><TextBlock Text="Falsimeter" FontSize="49" FontWeight="Bold" Foreground="White"/><TextBlock Text="Local LLM qualification — exact-digest policy" Foreground="#AFC8E5" FontSize="17" Margin="0,3,0,0"/></StackPanel></StackPanel></Border>
  <Grid Grid.Row="1" Margin="28,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="DiscoverButton" Click="Discover_Click" Background="#0069C7" BorderBrush="#36BCFF" FontSize="16" Content="⌕  Discover Local Models"/>
   <Button x:Name="QualifyButton" Grid.Column="1" Click="Qualify_Click" Margin="12,0,18,0" FontSize="16" Content="▷  Run checked"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="TestsButton" Content="☑  Choose tests" Click="Tests_Click"/><Button x:Name="CancelButton" Content="Stop" Click="Cancel_Click" IsEnabled="False" Margin="8,0"/><TextBlock x:Name="RootLabel" Foreground="#AFC8E5" Width="130" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel>
   <Button Grid.Column="3" Content="⚙" Click="Settings_Click" ToolTip="Model folders, local servers and host policy" Margin="10,0,0,0"/>
  </Grid>
  <Border Grid.Row="2" Margin="28,0,28,18" BorderBrush="#2B4258" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
   <DataGrid x:Name="ModelsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" Background="#0F1B29" Foreground="#EAF2FF" RowBackground="#0F1B29" AlternatingRowBackground="#111F2F" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#263A4E" HeadersVisibility="Column" CanUserAddRows="False" RowHeight="92">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="Run" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="Run selected tests against this model"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Model" Width="2.3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="17" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Source}" Foreground="#91AECF" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Exact digest" Width="3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Digest}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Foreground="#BFD3EA"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="0.8*"/>
     <DataGridTemplateColumn Header="Qualification" Width="2.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="17"/><TextBlock Text="{Binding Availability}" Foreground="#91AECF" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="⋯" Click="Details_Click" Padding="9,5" ToolTip="View model and test results"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <Border Grid.Row="3" BorderBrush="#26394B" BorderThickness="0,1,0,0" Padding="28,0"><DockPanel VerticalAlignment="Center"><TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#91AECF"/><TextBlock Text="●" Foreground="#32DF92" FontSize="18" Margin="0,0,12,0"/><TextBlock x:Name="StatusText" Text="Ready. Select Discover Local Models to begin." Foreground="#B9CEE6" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>
